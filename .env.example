# 在服务器环境变量中设置；不要把真实密钥提交或写入网页。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
# 云端由 Zeabur 环境变量设置，完整步骤见 docs/Zeabur部署指南.md
# AGENT_DEPLOYMENT=cloud
# HOST=0.0.0.0
# PORT=8080
# AGENT_STATE_DIR=/data
# AGENT_ALLOWED_HOSTS=your-domain.zeabur.app
# DEMO_ACCESS_PASSWORD=replace-with-at-least-16-random-characters
